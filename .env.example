# Firebase project configuration
# Get these values from Firebase Console > Project Settings > General > Your apps > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base URL of the Materials API (server/, deployed separately — see server/README.md).
# Local dev: http://localhost:4000. Production: your Vercel deployment URL.
VITE_API_BASE_URL=

# --- Backend only (server/) — never prefixed with VITE_, never sent to the browser ---

# Cloudflare R2 — Dashboard > R2 > Manage API Tokens (create one scoped to
# this bucket). Used only by server/config/r2.js. R2_ENDPOINT is
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com. After setting these, run
# `npm run r2:cors` once so the bucket accepts direct browser PUT/GET
# requests from this app's presigned URLs (see server/scripts/configureR2Cors.js).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Firebase Admin service account — Firebase Console > Project Settings >
# Service Accounts > Generate new private key. Lets the backend verify ID
# tokens and read/write Firestore with the Admin SDK (bypasses
# firestore.rules by design, same as functions/ does). FIREBASE_PRIVATE_KEY
# is the multi-line "private_key" field from that JSON file, pasted as one
# line with \n in place of real newlines.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Port the Express server listens on, and which frontend origin(s) may call
# it (comma-separated, or omit for * in local dev). Also read by
# `npm run r2:cors` to set the R2 bucket's own CORS policy — update this and
# re-run that script whenever the deployed frontend's origin changes.
PORT=4000
CORS_ORIGIN=
