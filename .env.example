# Firebase project configuration
# Get these values from Firebase Console > Project Settings > General > Your apps > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base URL of the Materials API (server/, deployed separately — see server/README.md).
# Local dev: http://localhost:4000. Production: your Vercel deployment URL.
VITE_API_BASE_URL=

# --- Backend only (server/) — never prefixed with VITE_, never sent to the browser ---

# Cloudinary — Dashboard > Settings > API Keys. Used only by server/config/cloudinary.js.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin service account — Firebase Console > Project Settings >
# Service Accounts > Generate new private key. Lets the backend verify ID
# tokens and read/write Firestore with the Admin SDK (bypasses
# firestore.rules by design, same as functions/ does). FIREBASE_PRIVATE_KEY
# is the multi-line "private_key" field from that JSON file, pasted as one
# line with \n in place of real newlines.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Local dev only — port the Express server listens on, and which frontend
# origin(s) may call it (comma-separated, or omit for * in local dev).
PORT=4000
CORS_ORIGIN=
